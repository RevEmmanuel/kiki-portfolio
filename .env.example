# Kiki Williams portfolio — environment variables
# Copy to .env.local for local work. On Vercel: Project → Settings → Environment Variables.
# Server-only variables (no NEXT_PUBLIC_ prefix) never reach the browser.

# ── Site ────────────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Leave unset on previews (Vercel's URL is used).
# Set to the real domain only once it is connected and confirmed.
NEXT_PUBLIC_SITE_URL=
# "true" lets search engines index the site. Leave unset (noindex) until launch is approved.
NEXT_PUBLIC_ALLOW_INDEXING=

# ── Enquiries (Resend) ──────────────────────────────────────────────────────────
# Server only. Resend dashboard → API Keys → Create API key (permission: Sending access).
RESEND_API_KEY=
# Where enquiries are delivered. Defaults to kikiwill7.kw@gmail.com.
ENQUIRY_TO_EMAIL=kikiwill7.kw@gmail.com
# Sender. Must be on a domain verified in Resend (Resend → Domains), e.g.
#   Kiki Williams website <enquiries@your-domain>
# Until a domain is verified, leave unset: the default onboarding@resend.dev sender only
# delivers to the email address that owns the Resend account.
ENQUIRY_FROM_EMAIL=
# Tests only: point the endpoint at a mock server.
# RESEND_API_URL=

# ── Films (Cloudflare Stream) ───────────────────────────────────────────────────
# Public. The "customer-XXXX" part of any Stream playback URL
# (Cloudflare dashboard → Stream → a video → Settings / embed code). Without it the theatre
# shows "This film is being prepared for streaming".
NEXT_PUBLIC_CF_STREAM_CUSTOMER_CODE=
# Optional, public. JSON map of film key → Stream UID, overriding src/content/stream-ids.json
# for this environment, e.g. {"shine":"a1b2…","saskay":"c3d4…"}
NEXT_PUBLIC_STREAM_IDS=

# Upload script only (npm run stream:upload). Never set these on Vercel.
# Account ID: Cloudflare dashboard → any zone or Workers & Pages → right sidebar "Account ID".
CLOUDFLARE_ACCOUNT_ID=
# Token: My Profile → API Tokens → Create Token → Custom → Account · Stream · Edit.
CLOUDFLARE_STREAM_API_TOKEN=

# ── Media pipeline (npm run media / stream:upload) ──────────────────────────────
# Folder holding the original Drive files, matched by exact filename.
MEDIA_SRC=
